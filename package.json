{
  "name": "symbol-tools",
  "version": "1.0.0",
  "description": "Symbol blockchain tools and libraries monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:ui": "pnpm -r test:ui",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rimraf node_modules",
    "dev": "pnpm -r --parallel dev"
  },
  "keywords": [
    "symbol",
    "blockchain",
    "nem",
    "catbuffer",
    "websocket",
    "openapi"
  ],
  "author": "ccHarvestasya",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@swc/core": "^1.16.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "globals": "^17.13.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile-compression": "^2.4.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
