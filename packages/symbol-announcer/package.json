{
  "name": "@nemnesia/symbol-announcer",
  "version": "1.0.0",
  "description": "SymbolブロックチェーンへトランザクションをアナウンスするためのTypeScriptライブラリ",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "symbol",
    "blockchain",
    "nem",
    "transaction",
    "announcer",
    "websocket",
    "typescript"
  ],
  "author": "ccHarvestasya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemnesia/symbol-tools.git",
    "directory": "packages/symbol-announcer"
  },
  "homepage": "https://github.com/nemnesia/symbol-tools/tree/main/packages/symbol-announcer#readme",
  "bugs": {
    "url": "https://github.com/nemnesia/symbol-tools/issues"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"{src,test,e2e}/**/*.ts\"",
    "format": "prettier --write \"{src,test,e2e}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --ui --coverage",
    "prepublishOnly": "pnpm run lint && pnpm run build && pnpm test",
    "publish:dryrun": "npm publish --dry-run",
    "publish:release": "npm run build && npm publish"
  },
  "dependencies": {
    "@nemnesia/symbol-websocket": "^0.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "volta": {
    "node": "20.19.6"
  }
}
