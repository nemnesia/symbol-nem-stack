{
  "id": "secret-backup-codec-v1",
  "provenance": {
    "source": "SNIF v1 Draft 2 sections 3.1, 6.1, 7 and 10",
    "derivation": "The valid account and mnemonic envelopes are the deterministic RFC 8949 CBOR and password-v1 values from codec-structural-matrix-v1. Header tamper changes the final salt byte, tag tamper changes the final encrypted-payload byte, and zlib cases change only compression to zlib; each resulting envelope was deterministically CBOR-encoded."
  },
  "constants": {
    "password": "SNIF password-v1 fixture",
    "wrongPassword": "SNIF password-v1 wrong fixture",
    "passwordFixture": "password-v1-fixed-v1"
  },
  "cases": [
    {
      "id": "account-valid",
      "input": {
        "envelopeCbor": "",
        "password": "normal"
      },
      "expected": {
        "payloadCbor": "A36761646472657373581968639B5DD5B49506D6C96B51B3FF565A98512DBBDB8A97808B697075626C69634B657958207B80BE99D38ED9BB7B33C3FE1C3087683BDEADF49AB664A08BE4215A53CE06EB6A707269766174654B65795820F532362ED9F59309EB1413027F1F742A07262C95B0257A97D3EF7FD95B51E77E"
      }
    },
    {
      "id": "mnemonic-valid",
      "input": {
        "envelopeCbor": "",
        "password": "normal"
      },
      "expected": {
        "payloadCbor": ""
      }
    },
    {
      "id": "account-wrong-password",
      "input": {
        "envelopeCbor": "",
        "password": "wrong"
      },
      "expected": { "error": "decryption-failed" }
    },
    {
      "id": "mnemonic-wrong-password",
      "input": {
        "envelopeCbor": "",
        "password": "wrong"
      },
      "expected": { "error": "decryption-failed" }
    },
    {
      "id": "account-header-tamper",
      "input": {
        "envelopeCbor": "",
        "password": "normal"
      },
      "expected": { "error": "decryption-failed" }
    },
    {
      "id": "account-tag-tamper",
      "input": {
        "envelopeCbor": "",
        "password": "normal"
      },
      "expected": { "error": "decryption-failed" }
    },
    {
      "id": "account-password-missing",
      "input": {
        "envelopeCbor": ""
      },
      "expected": { "error": "password-required" }
    },
    {
      "id": "mnemonic-password-missing",
      "input": {
        "envelopeCbor": ""
      },
      "expected": { "error": "password-required" }
    },
    {
      "id": "account-zlib",
      "input": {
        "envelopeCbor": ""
      },
      "expected": { "error": "invalid-envelope" }
    },
    {
      "id": "mnemonic-zlib",
      "input": {
        "envelopeCbor": ""
      },
      "expected": { "error": "invalid-envelope" }
    }
  ]
}
