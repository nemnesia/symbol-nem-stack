{
  "id": "connection-verification-v1",
  "provenance": {
    "source": "SNIF v1 Draft 2 sections 5.9 through 5.11",
    "derivation": "Fixed identifiers, time, audience, and grants define request, response, and connected-request verification outcomes."
  },
  "constants": {
    "requestId": "00112233445566778899AABBCCDDEEFF",
    "sessionId": "102132435465768798A9BACBDCEDFE0F",
    "challenge": "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F",
    "origin": "https://example.com",
    "requestedPermissions": ["account", "sign-transaction", "sign-message"]
  },
  "cases": [
    {
      "id": "partial-grant",
      "input": { "permissions": ["account", "sign-message"] },
      "expected": { "status": "verified" }
    },
    {
      "id": "unknown-permission",
      "input": { "permissions": ["account", "unknown"] },
      "expected": { "error": "invalid-payload" }
    },
    {
      "id": "proof-signature-tamper",
      "input": { "mutation": "proof-signature-bit-0" },
      "expected": { "error": "authorization-failed" }
    },
    {
      "id": "proof-session-mismatch",
      "input": { "mutation": "sessionId" },
      "expected": { "error": "authorization-failed" }
    },
    {
      "id": "record-audience",
      "input": { "recordOrigin": "https://example.com" },
      "expected": { "status": "verified", "evidence": "connection" }
    },
    {
      "id": "trusted-and-record-audience",
      "input": { "recordOrigin": "https://example.com", "trustedAudience": "https://example.com" },
      "expected": { "status": "verified", "evidence": "trusted-audience-and-connection" }
    },
    {
      "id": "one-audience-mismatch",
      "input": { "recordOrigin": "https://example.com", "trustedAudience": "https://attacker.example" },
      "expected": { "error": "invalid-context" }
    },
    { "id": "approved", "input": { "approved": true }, "expected": { "status": "verified" } },
    {
      "id": "authenticated-denial",
      "input": { "approved": false, "authenticatedRejection": true },
      "expected": { "status": "verified" }
    },
    {
      "id": "unauthenticated-denial",
      "input": { "approved": false, "authenticatedRejection": false },
      "expected": { "error": "unauthenticated-rejection" }
    }
  ]
}
