{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "normativeSymbolSdk", "mnemonic", "passphrase", "accountId", "cases"],
  "properties": {
    "id": { "type": "string" },
    "normativeSymbolSdk": { "const": "3.3.2-pure.2" },
    "mnemonic": { "type": "string", "minLength": 1 },
    "passphrase": { "type": "string" },
    "accountId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain", "network", "privateKey", "publicKey", "address"],
        "properties": {
          "chain": { "enum": ["symbol", "nem"] },
          "network": { "enum": ["mainnet", "testnet"] },
          "privateKey": { "$ref": "#/$defs/hex32" },
          "publicKey": { "$ref": "#/$defs/hex32" },
          "address": { "type": "string", "minLength": 39, "maxLength": 40 }
        }
      }
    }
  },
  "$defs": { "hex32": { "type": "string", "pattern": "^[0-9A-F]{64}$" } }
}
