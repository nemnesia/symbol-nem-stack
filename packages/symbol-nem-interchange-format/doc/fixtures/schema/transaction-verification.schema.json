{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "transaction-primitives-v1" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceCommit", "derivation"],
      "properties": {
        "source": { "type": "string" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "derivation": { "type": "string" }
      }
    },
    "constants": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "enum": ["symbol-transaction", "nem-transaction", "symbol-cosignature", "nem-cosignature-v1"] },
          "input": { "type": "object", "minProperties": 2 },
          "expected": { "type": "object", "required": ["result"], "properties": { "result": { "const": "verified" } } }
        },
        "allOf": [
          {
            "if": { "properties": { "id": { "enum": ["symbol-transaction", "nem-transaction"] } } },
            "then": {
              "properties": {
                "input": {
                  "type": "object",
                  "required": ["sourceTest", "unsignedPayload"],
                  "properties": {
                    "sourceTest": { "type": "string" },
                    "unsignedPayload": { "$ref": "#/$defs/hex" }
                  }
                },
                "expected": {
                  "type": "object",
                  "required": ["signature", "signedPayload", "result"],
                  "properties": {
                    "signature": { "$ref": "#/$defs/signature" },
                    "signedPayload": { "$ref": "#/$defs/hex" },
                    "result": { "const": "verified" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "id": { "const": "symbol-cosignature" } } },
            "then": {
              "properties": {
                "input": {
                  "type": "object",
                  "required": ["sourceTest", "aggregatePayload"],
                  "properties": {
                    "sourceTest": { "type": "string" },
                    "aggregatePayload": { "$ref": "#/$defs/hex" }
                  }
                },
                "expected": {
                  "type": "object",
                  "required": ["parentHash", "serializedCosignature", "result"],
                  "properties": {
                    "parentHash": { "$ref": "#/$defs/hash" },
                    "serializedCosignature": { "$ref": "#/$defs/hex" },
                    "result": { "const": "verified" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "id": { "const": "nem-cosignature-v1" } } },
            "then": {
              "properties": {
                "input": {
                  "type": "object",
                  "required": [
                    "privateKey",
                    "otherTransactionHash",
                    "multisigAccountAddress",
                    "timestamp",
                    "deadline",
                    "fee"
                  ],
                  "properties": {
                    "privateKey": { "$ref": "#/$defs/hash" },
                    "otherTransactionHash": { "$ref": "#/$defs/hash" },
                    "multisigAccountAddress": { "type": "string" },
                    "timestamp": { "type": "integer" },
                    "deadline": { "type": "integer" },
                    "fee": { "type": "string", "pattern": "^[0-9]+$" }
                  }
                },
                "expected": {
                  "type": "object",
                  "required": ["publicKey", "signature", "signedPayload", "result"],
                  "properties": {
                    "publicKey": { "$ref": "#/$defs/hash" },
                    "signature": { "$ref": "#/$defs/signature" },
                    "signedPayload": { "$ref": "#/$defs/hex" },
                    "result": { "const": "verified" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
    "hash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "signature": { "type": "string", "pattern": "^[0-9A-F]{128}$" }
  }
}
