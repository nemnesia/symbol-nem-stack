{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "zlib-profile-v1" },
    "provenance": {
      "type": "object",
      "required": ["source", "derivation"],
      "properties": { "source": { "type": "string" }, "derivation": { "type": "string" } }
    },
    "constants": {
      "type": "object",
      "required": ["plaintext", "zlib"],
      "properties": { "plaintext": { "$ref": "#/$defs/hex" }, "zlib": { "$ref": "#/$defs/hex" } }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "enum": ["valid", "raw-deflate", "gzip", "trailing-data", "checksum-tamper"] },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream"],
            "properties": { "stream": { "$ref": "#/$defs/hex" } }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["plaintext", "plaintextBytes"],
                "properties": { "plaintext": { "$ref": "#/$defs/hex" }, "plaintextBytes": { "const": 35 } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": { "error": { "const": "invalid-payload" } }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": { "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" } }
}
