{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "zlib-profile-v1" },
    "provenance": {
      "type": "object",
      "required": ["source", "derivation"],
      "properties": { "source": { "type": "string" }, "derivation": { "type": "string" } }
    },
    "constants": {
      "type": "object",
      "required": ["plaintext", "zlib"],
      "properties": { "plaintext": { "$ref": "#/$defs/hex" }, "zlib": { "$ref": "#/$defs/hex" } }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": {
            "enum": [
              "valid",
              "raw-deflate",
              "gzip",
              "trailing-data",
              "checksum-tamper",
              "limit-16mib",
              "limit-16mib-plus-one"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stream"],
            "properties": { "stream": { "$ref": "#/$defs/hex" } }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["plaintext", "plaintextBytes"],
                "properties": { "plaintext": { "$ref": "#/$defs/hex" }, "plaintextBytes": { "const": 35 } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["plaintextBytes", "plaintextSha256"],
                "properties": {
                  "plaintextBytes": { "const": 16777216 },
                  "plaintextSha256": { "$ref": "#/$defs/hash" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": { "error": { "enum": ["invalid-payload", "resource-limit"] } }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
    "hash": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
  }
}
