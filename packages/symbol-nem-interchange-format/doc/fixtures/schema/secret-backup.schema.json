{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "secret-backup-codec-v1" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "derivation"],
      "properties": { "source": { "type": "string" }, "derivation": { "type": "string" } }
    },
    "constants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["password", "wrongPassword", "passwordFixture"],
      "properties": {
        "password": { "type": "string", "minLength": 1 },
        "wrongPassword": { "type": "string", "minLength": 1 },
        "passwordFixture": { "const": "password-v1-fixed-v1" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": {
            "enum": [
              "account-valid",
              "mnemonic-valid",
              "account-wrong-password",
              "mnemonic-wrong-password",
              "account-header-tamper",
              "account-tag-tamper",
              "account-password-missing",
              "mnemonic-password-missing",
              "account-zlib",
              "mnemonic-zlib"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["envelopeCbor"],
            "properties": {
              "envelopeCbor": { "$ref": "#/$defs/hex" },
              "password": { "enum": ["normal", "wrong"] }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "payloadCbor": { "$ref": "#/$defs/hex" },
              "error": { "enum": ["decryption-failed", "password-required", "invalid-envelope"] }
            },
            "oneOf": [
              { "required": ["payloadCbor"], "properties": { "payloadCbor": { "$ref": "#/$defs/hex" } } },
              {
                "required": ["error"],
                "properties": { "error": { "enum": ["decryption-failed", "password-required", "invalid-envelope"] } }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": { "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" } }
}
