{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemnesia.dev/snif/fixtures/conformance-cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "cases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v1$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "derivation"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "derivation": { "type": "string", "minLength": 1 }
      }
    },
    "constants": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "input": { "type": "object" },
          "expected": { "type": "object", "minProperties": 1 }
        }
      }
    }
  }
}
