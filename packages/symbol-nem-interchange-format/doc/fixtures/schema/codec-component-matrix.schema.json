{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "provenance", "cases"],
  "properties": {
    "id": { "const": "codec-component-matrix-v1" },
    "mode": { "const": "encode-decode" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "kind", "document", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "contact",
              "address",
              "account",
              "mnemonic",
              "sign-request",
              "signed-transaction",
              "message-sign-request",
              "signature",
              "connection-request",
              "connection-response"
            ]
          },
          "kind": { "enum": ["normal", "boundary", "invalid"] },
          "document": { "type": "object" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "result": { "enum": ["success", "invalid-payload"] },
              "payloadCbor": { "$ref": "#/$defs/hex" },
              "envelopeCbor": { "$ref": "#/$defs/hex" },
              "encryption": { "$ref": "#/$defs/encryption" }
            },
            "oneOf": [
              {
                "required": ["result", "payloadCbor", "envelopeCbor"],
                "properties": {
                  "result": { "const": "success" },
                  "payloadCbor": true,
                  "envelopeCbor": true
                }
              },
              {
                "required": ["result"],
                "properties": { "result": { "const": "invalid-payload" } }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})*$" },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["password", "passwordUtf8", "salt", "nonce", "derivedKey", "aad", "ciphertext", "tag"],
      "properties": {
        "password": { "type": "string", "minLength": 1 },
        "passwordUtf8": { "$ref": "#/$defs/hex" },
        "salt": { "type": "string", "pattern": "^[0-9A-F]{32}$" },
        "nonce": { "type": "string", "pattern": "^[0-9A-F]{24}$" },
        "derivedKey": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "aad": { "$ref": "#/$defs/hex" },
        "ciphertext": { "$ref": "#/$defs/hex" },
        "tag": { "type": "string", "pattern": "^[0-9A-F]{32}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "derivation"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "derivation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
