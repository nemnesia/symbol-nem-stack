{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "password-v1-fixed-v1" },
    "provenance": {
      "type": "object",
      "required": ["source", "derivation"],
      "properties": { "source": { "type": "string" }, "derivation": { "type": "string" } }
    },
    "constants": {
      "type": "object",
      "required": ["argon2", "password", "passwordUtf8", "salt", "nonce"],
      "properties": {
        "argon2": { "type": "object" },
        "password": { "type": "string", "minLength": 1 },
        "passwordUtf8": { "$ref": "#/$defs/hex" },
        "salt": { "type": "string", "pattern": "^[0-9A-F]{32}$" },
        "nonce": { "type": "string", "pattern": "^[0-9A-F]{24}$" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected"],
        "properties": {
          "id": { "const": "valid-symbol-address" },
          "input": {
            "type": "object",
            "required": ["plaintext"],
            "properties": { "plaintext": { "$ref": "#/$defs/hex" } }
          },
          "expected": {
            "type": "object",
            "required": ["derivedKey", "aad", "ciphertext", "tag", "envelopeCbor"],
            "properties": {
              "derivedKey": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
              "aad": { "$ref": "#/$defs/hex" },
              "ciphertext": { "$ref": "#/$defs/hex" },
              "tag": { "type": "string", "pattern": "^[0-9A-F]{32}$" },
              "envelopeCbor": { "$ref": "#/$defs/hex" }
            }
          }
        }
      }
    }
  },
  "$defs": { "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" } }
}
