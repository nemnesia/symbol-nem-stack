{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "normativeSymbolSdk", "sources", "derivation", "cases"],
  "properties": {
    "id": { "const": "mnemonic-unicode-v1" },
    "normativeSymbolSdk": { "const": "3.3.2-pure.2" },
    "sources": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/source" } },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pbkdf2Iterations", "prf", "seedBytes", "accountId", "network"],
      "properties": {
        "pbkdf2Iterations": { "const": 2048 },
        "prf": { "const": "HMAC-SHA512" },
        "seedBytes": { "const": 64 },
        "accountId": { "const": 0 },
        "network": { "const": "mainnet" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "input", "expected"],
        "properties": {
          "id": {
            "enum": [
              "japanese-first-vector",
              "spanish-first-vector",
              "spanish-empty-passphrase",
              "utf8-1024-boundary",
              "nfc-rejected",
              "utf8-1025-rejected"
            ]
          },
          "source": { "$ref": "#/$defs/sourceWithEntropy" },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mnemonicDisplay", "passphraseDisplay", "mnemonic", "passphrase"],
            "properties": {
              "mnemonicDisplay": { "type": "string", "minLength": 1 },
              "passphraseDisplay": { "type": "string" },
              "mnemonic": { "type": "string", "minLength": 1 },
              "passphrase": { "type": "string" }
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["seed", "symbol", "nem"],
                "properties": {
                  "passphraseUtf8Bytes": { "type": "integer", "minimum": 0, "maximum": 1024 },
                  "seed": { "type": "string", "pattern": "^[0-9A-F]{128}$" },
                  "symbol": { "$ref": "#/$defs/account" },
                  "nem": { "$ref": "#/$defs/account" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": {
                  "passphraseUtf8Bytes": { "type": "integer", "minimum": 1025 },
                  "error": { "const": "invalid-payload" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "sourceWithEntropy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "entropy"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "entropy": { "type": "string", "pattern": "^[0-9A-Fa-f]{32,64}$" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKey", "address"],
      "properties": {
        "publicKey": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "address": { "type": "string", "minLength": 39, "maxLength": 40 }
      }
    }
  }
}
