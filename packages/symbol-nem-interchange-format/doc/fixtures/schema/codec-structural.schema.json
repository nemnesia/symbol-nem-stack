{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provenance", "constants", "cases"],
  "properties": {
    "id": { "const": "codec-structural-matrix-v1" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "constants": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": {
            "enum": [
              "contact",
              "address",
              "account",
              "mnemonic",
              "sign-request",
              "signed-transaction",
              "message-sign-request",
              "signature",
              "connection-request",
              "connection-response"
            ]
          },
          "input": {
            "type": "object",
            "required": ["formatType"],
            "properties": { "formatType": { "type": "string" } }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["payloadCbor", "envelopeCbor"],
            "properties": {
              "payloadCbor": { "$ref": "#/$defs/hex" },
              "envelopeCbor": { "$ref": "#/$defs/hex" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9A-F]{2})+$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "derivation"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "derivation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
