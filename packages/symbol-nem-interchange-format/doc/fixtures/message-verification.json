{
  "id": "message-verification-v1",
  "provenance": {
    "source": "SNIF v1 Draft 2 sections 5.7 and 5.11",
    "derivation": "The fixed request context and message define the deterministic message-signing frame; mutations identify the exact verification result."
  },
  "constants": {
    "requestId": "00112233445566778899AABBCCDDEEFF",
    "createdAt": 1735689600,
    "expiresAt": 1735690200,
    "audience": "https://example.com",
    "purpose": "authentication",
    "message": "534E49462066697874757265"
  },
  "cases": [
    {
      "id": "trusted-audience",
      "input": { "trustedAudience": "https://example.com", "now": 1735689700 },
      "expected": { "status": "verified", "evidence": "trusted-audience" }
    },
    {
      "id": "self-asserted-audience",
      "input": { "now": 1735689700 },
      "expected": { "status": "unverified", "evidence": "self-asserted" }
    },
    {
      "id": "audience-mismatch",
      "input": { "trustedAudience": "https://attacker.example", "now": 1735689700 },
      "expected": { "error": "invalid-context" }
    },
    { "id": "expired", "input": { "now": 1735690200 }, "expected": { "error": "expired-request" } },
    { "id": "message-tamper", "input": { "mutation": "message-bit-0" }, "expected": { "error": "verification-failed" } }
  ]
}
