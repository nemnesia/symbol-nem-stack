{
  "id": "codec-component-matrix-v1",
  "mode": "encode-decode",
  "provenance": {
    "source": "SNIF v1 Draft 2 sections 3, 5, and 10",
    "derivation": "Each entry is a complete diagnostic encoder document. hex: values denote exact byte strings. Normal, boundary, and invalid cases are reviewed independently; the invalid cases are required to fail before serialization."
  },
  "cases": [
    {
      "id": "contact-normal",
      "type": "contact",
      "kind": "normal",
      "document": {
        "type": "contact",
        "chain": "nem",
        "network": { "id": 104 },
        "payload": {
          "name": "SNIF Test Account",
          "address": "hex:68639B5DD5B49506D6C96B51B3FF565A98512DBBDB8A97808B",
          "publicKey": "hex:7B80BE99D38ED9BB7B33C3FE1C3087683BDEADF49AB664A08BE4215A53CE06EB"
        }
      },
      "expected": { "result": "success" }
    },
