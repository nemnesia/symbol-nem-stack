# Development and verification use the Symbol Testnet.
SYMTAX_EXPECTED_NETWORK=testnet
SYMTAX_EXPECTED_NETWORK_TYPE=152
SYMTAX_EXPECTED_GENERATION_HASH_SEED=3B5E1FA6445653C971A50687E75E6D09FB30481055E3990C84B25E9222DC1155
SYMTAX_EXPECTED_EPOCH_ADJUSTMENT_SECONDS=1616694977

# Symbol node database: separately operated MongoDB instance, read-only account.
# Set this to the URI for the selected Testnet node database.
SYMBOL_MONGO_URI=mongodb://symbol_reader:replace-me@symbol-node-mongo:27017/catapult?authSource=admin
SYMBOL_MONGO_DATABASE=catapult

# SymTax-owned database: separate mongod process and credentials from Symbol MongoDB.
# For the local Compose service, use localhost:27018 when the app runs on the host.
SYMTAX_MONGO_URI=mongodb://symtax_app:replace-this-app-password@127.0.0.1:27018/symtax?authSource=symtax
SYMTAX_MONGO_DATABASE=symtax

# Local Compose bootstrap credentials. These are only for the SymTax MongoDB service.
SYMTAX_MONGO_ROOT_USERNAME=symtax_root_local
SYMTAX_MONGO_ROOT_PASSWORD=replace-this-root-password
SYMTAX_MONGO_APP_USERNAME=symtax_app
SYMTAX_MONGO_APP_PASSWORD=replace-this-app-password
