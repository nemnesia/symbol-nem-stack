{
  "name": "symbol-finalization-proof-viewer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm --filter \"symbol-finalization-proof-viewer^...\" --if-present run build && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run src",
    "clean": "rimraf dist",
    "lint": "oxlint .",
    "generate:api": "openapi-typescript openapi/openapi.yml --output src/schema.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "metal:forge:test": "pnpm build && cd ../metal && npx metal forge -o ../symbol-finalization-proof-viewer/metalForgeInfo.json --node-url http://sakia.harvestasya.com:3000 --seal 2 ../symbol-finalization-proof-viewer/dist/index.html",
    "metal:scrap:test": "cd ../metal && npx metal scrap -o ../symbol-finalization-proof-viewer/metalScrapInfo.json --node-url http://sakia.harvestasya.com:3000"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@nemnesia/nodewatch-openapi-provider": "workspace:*",
    "@nemnesia/nodewatch-openapi-typescript-fetch-client": "workspace:*",
    "@nemnesia/symbol-nem-node-picker": "workspace:*",
    "@nemnesia/symbol-openapi-typescript-fetch-client": "workspace:*",
    "@nemnesia/symbol-sdk": "workspace:*",
    "@nemnesia/symbol-websocket": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
